<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/main_tabs"
        style="@style/Amethyst.Tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_tab_content" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_tab_tools" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_tab_community" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_tab_servers" />
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/padding_large"
        android:paddingTop="@dimen/padding_moderate"
        android:paddingBottom="@dimen/padding_heavy"
        app:layout_constraintBottom_toTopOf="@id/_background_display_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_tabs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/section_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/content_mods_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_large"
                    android:drawableStart="@drawable/ic_menu_download"
                    android:text="@string/content_mods" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/content_shaders_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_large"
                    android:drawableStart="@drawable/ic_menu_shader"
                    android:text="@string/content_shaders" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/content_resourcepacks_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_large"
                    android:drawableStart="@drawable/ic_menu_resourcepack"
                    android:text="@string/content_resourcepacks" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/content_datapacks_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_datapack"
                    android:text="@string/content_datapacks" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_large"
                    android:orientation="vertical">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/custom_control_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_menu_gamepad"
                        android:text="@string/mcl_option_customcontrol" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/install_jar_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:drawableStart="@drawable/ic_menu_download"
                        android:text="@string/main_install_jar_file" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/share_logs_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_menu_logs"
                        android:text="@string/main_share_logs" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/open_files_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:drawableStart="@drawable/ic_menu_folder"
                        android:text="@string/mcl_button_open_directory" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_community"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/news_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_large"
                    android:drawableStart="@drawable/ic_menu_article"
                    android:text="@string/mcl_tab_wiki" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/discord_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_discord"
                    android:text="@string/mcl_button_discord" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/server_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_servers_empty"
                    android:textColor="@color/secondary_text" />

                <LinearLayout
                    android:id="@+id/server_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/server_create_button"
                    style="@style/Amethyst.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_large"
                    android:text="@string/main_servers_create" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- This view is for cosmetic purpose only -->
    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-8dp"
        android:background="@color/background_bottom_bar"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"

        android:background="@android:color/transparent"
        android:drawableEnd="@drawable/spinner_arrow"
        app:drawableEndPadding="@dimen/_1sdp"
        app:drawableEndSize="@dimen/_12sdp"

        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_36sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/_8sdp"

        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/main_menu_edit_profile"
        android:src="@drawable/ic_edit_profile"
        app:tint="@color/primary_text"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@+id/play_button"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginEnd="@dimen/_8sdp"
        android:text="@string/main_play"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />
</androidx.constraintlayout.widget.ConstraintLayout>
